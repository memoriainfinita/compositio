{
  "name": "compositio",
  "private": true,
  "version": "0.0.0",
  "description": "Prepare audio and video for live shows in the browser with ffmpeg.wasm",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoriainfinita/compositio.git"
  },
  "scripts": {
    "dev": "node scripts/copy-ffmpeg.mjs && vite",
    "build": "node scripts/copy-ffmpeg.mjs && pnpm typecheck && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
